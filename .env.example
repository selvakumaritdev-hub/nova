# ==============================================================================
# NOVA MALL - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Add these variables to your Vercel Project Settings -> Environment Variables
# ==============================================================================

# Client API Base URL (leave empty when deploying to Vercel for same-origin /api routes)
VITE_API_URL=

# Supabase Database Connection
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner Admin Dashboard Security
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
